<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<!-- Lesson screen: the explanation, videos and follow-up questions -->
<StackPane fx:id="root" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.app.HelloController">
   <children>
      <MediaView fx:id="mediaView" managed="false" />
      <Region styleClass="scrim" />

      <BorderPane>
         <top>
            <HBox styleClass="top-bar" alignment="CENTER_LEFT">
               <children>
                  <Button text="← New topic" onAction="#switchToScene1" />
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="top-kicker" text="YOUR LESSON" />
                        <Label fx:id="topicLabel" styleClass="top-title" />
                     </children>
                  </VBox>
                  <Button text="Quiz me (5 questions)" onAction="#startQuiz" />
                  <Button styleClass="primary" text="Try the practice problem →" onAction="#switchToScene3" />
               </children>
            </HBox>
         </top>
         <center>
            <ScrollPane fx:id="lessonScroll" fitToWidth="true" hbarPolicy="NEVER">
               <content>
                  <VBox styleClass="page" alignment="TOP_CENTER" spacing="12.0">
                     <children>
                        <Label fx:id="errorLabel" styleClass="error" wrapText="true" maxWidth="860.0" />
                        <VBox fx:id="lessonContent" spacing="16.0" maxWidth="860.0" />
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </center>
         <bottom>
            <HBox styleClass="ask-bar" alignment="CENTER">
               <children>
                  <TextField fx:id="textField2" promptText="Ask a follow-up question about this lesson..." maxWidth="760.0" HBox.hgrow="ALWAYS" onAction="#followUpInput" />
                  <Button fx:id="askButton" styleClass="primary" text="Ask" onAction="#followUpInput" />
               </children>
            </HBox>
         </bottom>
      </BorderPane>

      <VBox fx:id="loadingOverlay" styleClass="loading" alignment="CENTER" visible="false">
         <children>
            <ProgressIndicator prefWidth="60.0" prefHeight="60.0" />
            <Label styleClass="loading-label" text="Writing your quiz..." />
            <Label styleClass="subtitle" text="This usually takes 10 to 20 seconds" />
         </children>
      </VBox>
   </children>
</StackPane>
