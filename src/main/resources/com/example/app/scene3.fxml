<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<!-- Practice screen: multiple choice question with instant feedback -->
<StackPane fx:id="root" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.app.HelloController">
   <children>
      <MediaView fx:id="mediaView" managed="false" />
      <Region styleClass="scrim" />

      <BorderPane>
         <top>
            <HBox styleClass="top-bar" alignment="CENTER_LEFT">
               <children>
                  <Button text="← Back to lesson" onAction="#switchToScene2FromScene3" />
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="top-kicker" text="PRACTICE PROBLEM" />
                        <Label fx:id="topicLabel" styleClass="top-title" />
                     </children>
                  </VBox>
                  <Label fx:id="scoreLabel" styleClass="score" />
               </children>
            </HBox>
         </top>
         <center>
            <ScrollPane fx:id="practiceScroll" fitToWidth="true" hbarPolicy="NEVER">
               <content>
                  <VBox styleClass="page" alignment="TOP_CENTER">
                     <children>
                        <VBox fx:id="practiceContent" spacing="16.0" maxWidth="860.0" />
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </center>
      </BorderPane>
   </children>
</StackPane>
