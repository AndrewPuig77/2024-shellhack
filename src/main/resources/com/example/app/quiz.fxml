<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>

<!-- Quiz screen: five questions one at a time, then a results summary -->
<StackPane fx:id="root" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.app.HelloController">
   <children>
      <MediaView fx:id="mediaView" managed="false" />
      <Region styleClass="scrim" />

      <BorderPane>
         <top>
            <HBox styleClass="top-bar" alignment="CENTER_LEFT">
               <children>
                  <Button text="← Back to lesson" onAction="#switchToScene2FromScene3" />
                  <VBox HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="top-kicker" text="QUIZ" />
                        <Label fx:id="topicLabel" styleClass="top-title" />
                     </children>
                  </VBox>
                  <Label fx:id="scoreLabel" styleClass="score" />
               </children>
            </HBox>
         </top>
         <center>
            <ScrollPane fx:id="practiceScroll" fitToWidth="true" hbarPolicy="NEVER">
               <content>
                  <VBox styleClass="page" alignment="TOP_CENTER" spacing="12.0">
                     <children>
                        <Label fx:id="errorLabel" styleClass="error" wrapText="true" maxWidth="860.0" />
                        <VBox fx:id="quizContent" spacing="16.0" maxWidth="860.0" />
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </center>
      </BorderPane>

      <VBox fx:id="loadingOverlay" styleClass="loading" alignment="CENTER" visible="false">
         <children>
            <ProgressIndicator prefWidth="60.0" prefHeight="60.0" />
            <Label styleClass="loading-label" text="Writing your quiz..." />
            <Label styleClass="subtitle" text="This usually takes 10 to 20 seconds" />
         </children>
      </VBox>
   </children>
</StackPane>
